# Bu dosyayı .env olarak kopyalayın ve değerleri değiştirin (.env git'e girmez).
# Güçlü rastgele değer üretmek için (PowerShell):
#   [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# veya (bash):  openssl rand -hex 32

POSTGRES_USER=postgres
POSTGRES_PASSWORD=degistir
POSTGRES_DB=scootly

# Api, Worker ve Mvc bu rolle bağlanır (yalnızca veri okuma/yazma; db-init servisi oluşturur).
# Süper kullanıcı (POSTGRES_USER) yalnızca migration ve db-init tarafından kullanılır.
APP_DB_USER=scootly_app
APP_DB_PASSWORD=

RABBITMQ_USER=scootly
RABBITMQ_PASSWORD=degistir

REDIS_PASSWORD=degistir

# Yalnızca "--profile app" ile uygulama servisleri container'da çalıştırılırken kullanılır.
# Her biri en az 32 karakter olmalı.
JWT_KEY=
# Yalnızca SignalR hub token'ları için ayrı anahtar (Mvc yalnızca bunu bilir, JWT_KEY'i bilmez).
JWT_HUB_KEY=
DEVICE_CLIENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# İsteğe bağlı: ilk filo yöneticisi hesabı (API açılışında oluşturulur).
BOOTSTRAP_FLEET_MANAGER_EMAIL=
BOOTSTRAP_FLEET_MANAGER_PASSWORD=

# Gözlemlenebilirlik: Grafana yönetici parolası (--profile observability).
GRAFANA_ADMIN_PASSWORD=degistir

# Opsiyonel nesne depolama (fotoğraf yükleme). "--profile storage" ile SeaweedFS başlar;
# Mvc'nin yükleme alanını göstermesi için STORAGE_ENABLED=true yapın. Gizli anahtar en az 16 karakter olmalı.
STORAGE_ENABLED=false
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
