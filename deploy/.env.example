# Bu dosyayı .env olarak kopyalayın ve değerleri değiştirin (.env git'e girmez).
# Güçlü rastgele değer üretmek için (PowerShell):
#   [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# veya (bash):  openssl rand -hex 32

POSTGRES_USER=postgres
POSTGRES_PASSWORD=degistir
POSTGRES_DB=scootly

RABBITMQ_USER=scootly
RABBITMQ_PASSWORD=degistir

REDIS_PASSWORD=degistir

# Yalnızca "--profile app" ile uygulama servisleri container'da çalıştırılırken kullanılır.
# Her biri en az 32 karakter olmalı.
JWT_KEY=
DEVICE_CLIENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# İsteğe bağlı: ilk filo yöneticisi hesabı (API açılışında oluşturulur).
BOOTSTRAP_FLEET_MANAGER_EMAIL=
BOOTSTRAP_FLEET_MANAGER_PASSWORD=

# Observability: Grafana admin password (--profile observability).
GRAFANA_ADMIN_PASSWORD=degistir
