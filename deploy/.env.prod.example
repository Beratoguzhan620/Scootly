# Üretim sırları şablonu. deploy/.env.prod olarak kopyalayıp doldurun; .env.prod git'e girmez.
# --env-file verildiğinde Compose varsayılan .env dosyasını OKUMAZ; temel dosyanın istediği
# her değişken burada tanımlı olmalıdır (Grafana dahil, üretimde kullanılmasa bile).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=degistir
POSTGRES_DB=scootly

# Uygulama rolü (yalnızca veri okuma/yazma).
APP_DB_USER=scootly_app
APP_DB_PASSWORD=degistir

RABBITMQ_USER=scootly
RABBITMQ_PASSWORD=degistir

REDIS_PASSWORD=degistir

# Her biri en az 32 karakter.
JWT_KEY=degistir
JWT_HUB_KEY=degistir
DEVICE_CLIENT_SECRET=degistir
PAYMENT_WEBHOOK_SECRET=degistir

BOOTSTRAP_FLEET_MANAGER_EMAIL=
BOOTSTRAP_FLEET_MANAGER_PASSWORD=

GRAFANA_ADMIN_PASSWORD=degistir

# Noktalı virgülle ayrılmış izinli Host değerleri. "api": PaymentSimulator webhook'u Host: api ile gönderir.
ALLOWED_HOSTS=localhost;api

SCOOTLY_VERSION=1.0.0