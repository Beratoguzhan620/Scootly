# Bu dosyayı .env.local olarak kopyalayın (.env.local git'e girmez).

# Scootly API adresi. Boş bırakılırsa geliştirmede Metro'nun çalıştığı bilgisayarın adresi + 5016 portu kullanılır.
# Örnekler:
#   iOS simülatörü:      http://localhost:5016
#   Android emülatörü:   http://10.0.2.2:5016
#   Fiziksel telefon:    http://192.168.1.20:5016   (bilgisayarın yerel ağ IP'si; API'nin 0.0.0.0'da dinlemesi gerekir)
EXPO_PUBLIC_API_URL=

# Yalnızca Android geliştirme/üretim derlemesi alırken gerekir (Expo Go'da gerekmez).
GOOGLE_MAPS_ANDROID_API_KEY=
