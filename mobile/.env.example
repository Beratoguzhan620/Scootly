# Bu dosyayı .env.local olarak kopyalayın (.env.local git'e girmez).
# Bu şablon herkese açık depoda: buraya yalnızca örnek değer yazın, gerçek sunucu adresi .env.local'e girer.
# EXPO_PUBLIC_ ile başlayan değerler uygulama paketine düz metin olarak gömülür; sır (anahtar, token, parola) koymayın.

# Varsayılan Scootly API adresi. Uygulama içindeki "Sunucu ayarları" bunun önüne geçer.
# Boş bırakılırsa geliştirmede Metro'nun çalıştığı bilgisayarın adresi + 5016 portu kullanılır.
# Örnekler:
#   iOS simülatörü:      http://localhost:5016
#   Android emülatörü:   http://10.0.2.2:5016
#   Fiziksel telefon:    http://192.168.1.20:5017   (bilgisayarın yerel ağ IP'si; README → API'ye Bağlanma)
EXPO_PUBLIC_API_URL=

# Mağaza sürümünde sunucu ayarlarını gizler (sabit HTTPS adresiyle birlikte kullanın).
# EXPO_PUBLIC_LOCK_API_URL=true

# Harita stili (varsayılan: OpenFreeMap positron; uygulama renklerine boyanır). Başka bir MapLibre stili de olur.
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Derleme ayarları (app.config.ts okur):
# SCOOTLY_ALLOW_HTTP=false     # mağaza sürümü: Android'de düz HTTP'yi kapat
# SCOOTLY_VERSION_CODE=2       # Android versionCode / iOS buildNumber (her yeni derlemede artırın)
