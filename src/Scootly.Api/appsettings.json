{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "Scootly.Api",
    "Audience": "Scootly.Clients",
    "ExpiryMinutes": 60
  },
  "DeviceAuth": {
    "ClientId": "scootly-device-simulator",
    "TokenLifetimeMinutes": 60
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "scootly",
    "VirtualHost": "/"
  },
  "Messaging": {
    "Enabled": true,
    "PrefetchCount": 10,
    "RetryDelayMilliseconds": 10000,
    "MaxRetryAttempts": 3
  },
  "PaymentGateway": {
    "BaseUrl": "http://localhost:5094",
    "AttemptTimeoutSeconds": 5,
    "TotalTimeoutSeconds": 20
  },
  "PaymentWebhook": {
    "ToleranceSeconds": 300
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "RateLimiting": {
    "AnonymousPerMinute": 60,
    "AuthPerMinute": 10,
    "UserPerMinute": 30,
    "DevicePerMinute": 600,
    "WebhookPerMinute": 300
  }
}
