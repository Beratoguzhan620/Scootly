<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scootly.Application\Scootly.Application.csproj" />
    <ProjectReference Include="..\Scootly.Domain\Scootly.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      JwtBearer paketi burada da referanslanıyor. Bu projenin ara katmana
      ihtiyacı yok; ihtiyacı olan, token ÜRETEN tarafın (JwtTokenGenerator) ve
      token DOĞRULAYAN tarafın (Api) aynı Microsoft.IdentityModel sürümünü
      kullanmasıdır. İki ayrı sürüm, imzalama ile doğrulama arasında teşhisi zor
      uyumsuzluklar üretir.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="3.3.1" />

    <!--
      46-50. günler için gereken paketler (Redis ve Extensions) kurulum
      betiğinde `dotnet add package` ile ekleniyor, buraya elle sürüm
      yazılmıyor: uydurulan bir sürüm numarası restore'u kırar ve hata
      mesajı gerçek sorunu göstermez.
    -->
  </ItemGroup>

</Project>
