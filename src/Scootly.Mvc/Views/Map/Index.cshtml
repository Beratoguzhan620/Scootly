@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Harita";
}

<link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />

<h1>Araç Haritası <span id="connection-status" class="badge bg-secondary">Bağlanıyor...</span></h1>

@if (ViewBag.FleetView != true)
{
    <p class="text-muted">Yalnızca müsait araçlar gösteriliyor.</p>
}

<div id="map"
     data-api-base="@Configuration["ApiBaseUrl"]"
     data-hub-token="@ViewBag.HubToken"
     data-regions="@ViewBag.Regions"
     data-fleet-view="@(ViewBag.FleetView == true ? "true" : "false")"
     data-vehicles-url="@Url.Action("Vehicles", "Map")"
     style="height: 600px;"></div>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
    <script src="~/js/live-connection.js" asp-append-version="true"></script>
}
