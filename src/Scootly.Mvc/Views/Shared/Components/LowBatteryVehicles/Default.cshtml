@using Scootly.Mvc.ViewComponents
@model IReadOnlyList<Scootly.Application.Abstractions.VehicleSummary>

<div class="card">
    <div class="card-header">Düşük Bataryalı Araçlar (@(Model.Count >= LowBatteryVehiclesViewComponent.ListLimit ? $"{LowBatteryVehiclesViewComponent.ListLimit}+" : Model.Count.ToString()))</div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">Düşük bataryalı araç yok.</p>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var vehicle in Model.Take(5))
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <code>@vehicle.Id.ToString()[..8]</code>
                        <span class="badge bg-danger">%@vehicle.BatteryPercentage</span>
                    </li>
                }
            </ul>
        }
    </div>
</div>