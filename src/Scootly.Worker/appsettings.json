{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "scootly",
    "VirtualHost": "/"
  },
  "Messaging": {
    "Enabled": true
  },
  "PaymentGateway": {
    "BaseUrl": "http://localhost:5094"
  },
  "Worker": {
    "AbandonedRideThreshold": "02:00:00",
    "PaymentRetryBackoff": "00:10:00",
    "UnchargedRideGracePeriod": "00:05:00",
    "LowBatteryTaskCooldown": "06:00:00",
    "TelemetryRetentionDays": 30,
    "RideLocationRetentionDays": 90,
    "OutboxRetentionDays": 7,
    "ProcessedMessageRetentionDays": 30
  }
}
